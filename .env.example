NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# localhost:5434 porque os comandos de migration rodam na maquina do dev, fora do container,
# e a 5432 do host costuma ja ter um postgres nativo. dentro da rede do compose o
# servico continua na 5432, entao o compose sobrescreve DB_HOST/DB_PORT/REDIS_HOST
DB_HOST=localhost
DB_PORT=5434
DB_USER=orquestrador
DB_PASS=orquestrador
DB_NAME=orquestrador

REDIS_HOST=localhost
REDIS_PORT=6379

ENRICHMENT_DEFAULT_SOURCE=dummyjson
ENRICHMENT_TIMEOUT_MS=3000
DUMMYJSON_BASE_URL=https://dummyjson.com

# moeda base do sistema. pedido que ja chega nela nao dispara conversao nenhuma
CONVERSION_TARGET_CURRENCY=USD
EXCHANGE_BASE_URL=https://api.frankfurter.app
